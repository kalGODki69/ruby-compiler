%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "parser.tab.h"


char string_buf[4096];
int  string_len = 0;

void append_char(char c) {
    if (string_len < 4095)
        string_buf[string_len++] = c;
}
void reset_buf(void) {
    string_len = 0;
}


char *copy_string(const char *src) {
    char *dst = (char *) malloc(strlen(src) + 1);
    if (dst) strcpy(dst, src);
    return dst;
}


int cur_line = 1;
int cur_col  = 1;

#define YY_USER_ACTION \
    yylloc.first_line   = yylloc.last_line   = cur_line; \
    yylloc.first_column = cur_col; \
    for (int i = 0; yytext[i]; i++) { \
        if (yytext[i] == '\n') { cur_line++; cur_col = 1; } \
        else cur_col++; \
    } \
    yylloc.last_column = cur_col - 1;
%}

%option noyywrap


%x DQSTRING
%x SQSTRING
%x COMMENT


DIGIT       [0-9]
INTEGER     {DIGIT}+
FLOAT       {DIGIT}+"."{DIGIT}+
ID          [a-zA-Z_][a-zA-Z_0-9]*

%%


{INTEGER}       { yylval.intval = atoi(yytext); return INT; }
{FLOAT}         { yylval.floatval = atof(yytext); return FLOAT; }


"if"            { return KW_IF; }
"elsif"         { return KW_ELSIF; }
"else"          { return KW_ELSE; }
"end"           { return KW_END; }
"unless"        { return KW_UNLESS; }
"while"         { return KW_WHILE; }
"until"         { return KW_UNTIL; }
"for"           { return KW_FOR; }
"in"            { return KW_IN; }
"do"            { return KW_DO; }
"def"           { return KW_DEF; }
"class"         { return KW_CLASS; }
"module"        { return KW_MODULE; }
"return"        { return KW_RETURN; }
"yield"         { return KW_YIELD; }
"break"         { return KW_BREAK; }
"next"          { return KW_NEXT; }
"true"          { return KW_TRUE; }
"false"         { return KW_FALSE; }
"nil"           { return KW_NIL; }
"self"          { return KW_SELF; }
"super"         { return KW_SUPER; }
"and"           { return KW_AND; }
"or"            { return KW_OR; }
"not"           { return KW_NOT; }
"begin"         { return KW_BEGIN; }
"rescue"        { return KW_RESCUE; }
"ensure"        { return KW_ENSURE; }
"raise"         { return KW_RAISE; }
"case"          { return KW_CASE; }
"when"          { return KW_WHEN; }
"then"          { return KW_THEN; }
"puts"          { return KW_PUTS; }
"print"         { return KW_PRINT; }
"p"             { return KW_P; }


{ID}            { yylval.strval = copy_string(yytext); return ID; }


"==="           { return OP_CASE_EQ; }
"<=>"           { return OP_CMP; }
"=="            { return OP_EQ; }
"!="            { return OP_NEQ; }
"<="            { return OP_LE; }
">="            { return OP_GE; }
"**"            { return OP_POW; }
"+="            { return OP_PLUS_ASSIGN; }
"-="            { return OP_MINUS_ASSIGN; }
"*="            { return OP_MUL_ASSIGN; }
"/="            { return OP_DIV_ASSIGN; }
"<<"            { return OP_LSHIFT; }
">>"            { return OP_RSHIFT; }
"&&"            { return OP_AND; }
"||"            { return OP_OR; }
"..."           { return OP_RANGE_EXC; }
".."            { return OP_RANGE_INC; }
"::"            { return OP_SCOPE; }
"=>"            { return OP_HASH_ROCKET; }
"<"             { return '<'; }
">"             { return '>'; }
"="             { return '='; }
"+"             { return '+'; }
"-"             { return '-'; }
"*"             { return '*'; }
"/"             { return '/'; }
"%"             { return '%'; }
"!"             { return '!'; }
"&"             { return '&'; }
"|"             { return '|'; }
"^"             { return '^'; }
"~"             { return '~'; }
"."             { return '.'; }
"?"             { return '?'; }
":"             { return ':'; }
";"             { return ';'; }
","             { return ','; }
"("             { return '('; }
")"             { return ')'; }
"["             { return '['; }
"]"             { return ']'; }
"{"             { return '{'; }
"}"             { return '}'; }

\"              { reset_buf(); BEGIN(DQSTRING); }

<DQSTRING>\\n   { append_char('\n'); }
<DQSTRING>\\t   { append_char('\t'); }
<DQSTRING>\\r   { append_char('\r'); }
<DQSTRING>\\b   { append_char('\b'); }
<DQSTRING>\\f   { append_char('\f'); }
<DQSTRING>\\\"  { append_char('"'); }
<DQSTRING>\\\\  { append_char('\\'); }

<DQSTRING>\"    {
    string_buf[string_len] = '\0';
    yylval.strval = copy_string(string_buf);
    BEGIN(INITIAL);
    return STRING;
}

<DQSTRING>\n    {
    string_buf[string_len] = '\0';
    yylval.strval = copy_string(string_buf);
    BEGIN(INITIAL);
    return STRING;
}

<DQSTRING>.     { append_char(yytext[0]); }

\'              { reset_buf(); BEGIN(SQSTRING); }
<SQSTRING>\\\\  { append_char('\\'); }
<SQSTRING>\\\'  { append_char('\''); }

<SQSTRING>\'    {
    string_buf[string_len] = '\0';
    yylval.strval = copy_string(string_buf);
    BEGIN(INITIAL);
    return STRING_SQ;
}

<SQSTRING>\n    {
    string_buf[string_len] = '\0';
    yylval.strval = copy_string(string_buf);
    BEGIN(INITIAL);
    return STRING_SQ;
}

<SQSTRING>.     { append_char(yytext[0]); }

"#"             { BEGIN(COMMENT); }
<COMMENT>\n     { BEGIN(INITIAL); }
<COMMENT>.      { }


[ \t\n]+        { }


.               { return YYUNDEF; }

%%